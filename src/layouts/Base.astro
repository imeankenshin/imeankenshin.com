---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { Font } from "astro:assets";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "@/utils/site-identity";
import { isEditorView } from "@/utils/editor-view";
import CloudflareWebAnalytics from "@/components/CloudflareWebAnalytics.astro";
import "@/styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** "article" for blog posts (og:type=article + BlogPosting JSON-LD); others are "website" */
	pageType?: "website" | "article";
	articleMeta?: { publishedTime?: string | null; modifiedTime?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	pageType = "website",
	articleMeta,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

// フッターのコピーライト表記
const AUTHOR_NAME = "Kenshin Omura";
// ヘッダー左上のロゴ文字。ページタイトル用のサイト名（Settings の title）とは別にドメイン名を出す
const HEADER_WORDMARK = "imeankenshin.com";

const { siteTitle, siteTagline, siteLogo, useDefaultFavicon } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
// ロゴがトップへのリンクを兼ねるので、メニューのトップ（"/"）へのリンクはヘッダーに出さない
const navItems = (menuResult.data?.items ?? []).filter((item) => item.url !== "/");

// 下書きのプレビュー・編集から別のページへ移るとき、未公開の記事の URL を Referer で渡さない
// （移動先のページのアクセス解析が参照元として Cloudflare に送るため）
const hideReferrer = isEditorView(Astro.url);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	articleMeta,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{hideReferrer && <meta name="referrer" content="no-referrer" />}
		<title>{fullTitle}</title>
		{useDefaultFavicon && <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
		<Font cssVariable="--font-inter" />
		<Font cssVariable="--font-noto-sans-jp" />
		<Font cssVariable="--font-jetbrains-mono" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<div class="wrap">
				<a class="site-title" href="/">
					{siteLogo ? (
						<img
							src={siteLogo.url}
							alt={siteLogo.alt || HEADER_WORDMARK}
							style="height:32px;width:auto;display:block;"
						/>
					) : (
						HEADER_WORDMARK
					)}
				</a>
				<nav class="site-nav" aria-label="メイン">
					{navItems.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={Astro.url.pathname === item.url ? "page" : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>
			</div>
		</header>

		<main class="site-main">
			<div class="wrap">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<span class="footer-meta">
					<span>
						© {new Date().getFullYear()} {AUTHOR_NAME}
					</span>
					<a href="/privacy" aria-current={Astro.url.pathname === "/privacy" ? "page" : undefined}>
						プライバシーポリシー
					</a>
				</span>
				<slot name="footer" />
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
		<CloudflareWebAnalytics />
		{
			/*
			 * Vite DevTools のドック。Astro は SSR で HTML を返すため Vite の自動注入が効かない。
			 * 開発サーバーのハブが配信する embedded.js を、Vite のモジュールグラフを通さずに読み込む。
			 * import.meta.env.DEV はビルド時に false になり、本番 HTML には出力されない。
			 */
			import.meta.env.DEV && <script is:inline type="module">
				const s = document.createElement("script");
				s.type = "module";
				s.src = "/__devtools/embedded.js";
				document.body.appendChild(s);
			</script>
		}
	</body>
</html>
