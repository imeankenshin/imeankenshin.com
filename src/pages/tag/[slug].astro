---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../utils/date";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`タグ: ${term.label}`} description={`「${term.label}」の記事一覧`}>
	<p class="meta" style="margin:0">タグ</p>
	<h1>#{term.label}</h1>

	{
		posts.length === 0 ? (
			<p class="meta">まだ記事がありません。</p>
		) : (
			<ul class="post-list" style="margin-top:2rem">
				{posts.map((post) => (
					<li>
						{post.data.publishedAt && (
							<time class="meta" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
						)}
						<h2><a class="title" href={`/posts/${post.id}`} {...post.edit.title}>{post.data.title}</a></h2>
						{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
					</li>
				))}
			</ul>
		)
	}
	<nav class="pager" aria-label="ページ送り">
		{cursor ? <a href={`/tag/${term.slug}`}>← 最初のページ</a> : <span />}
		{nextCursor && <a href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>次のページ →</a>}
	</nav>
</Base>
