---
import { getEmDashEntry, getMenuWithCacheHint, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

// トップの自己紹介は Pages コレクションの "home"、リンク集は "links" メニューから読む。
const [intro, linksResult, settings] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getMenuWithCacheHint("links"),
	getSiteSettings(),
]);
const home = intro.entry;
const menuLinks = linksResult.data?.items ?? [];
const xUrl = "https://x.com/imeankenshin";
const links = menuLinks.some((item) => item.url.replace(/\/$/, "") === xUrl)
	? menuLinks
	: [...menuLinks, { label: "X", url: xUrl, target: "_blank" }];
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);
if (Astro.cache?.enabled) {
	Astro.cache.set(intro.cacheHint);
	Astro.cache.set(linksResult.cacheHint);
}

// リンク先のサービスに合わせたアイコン（Phosphor Icons, MIT）
const ICONS: Record<string, string> = {
	"github.com":
		"M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z",
	"x.com":
		"M214.75,211.71l-62.6-98.38,61.77-67.95a8,8,0,0,0-11.84-10.76L143.24,99.34,102.75,35.71A8,8,0,0,0,96,32H48a8,8,0,0,0-6.75,12.3l62.6,98.37-61.77,68a8,8,0,1,0,11.84,10.76l58.84-64.72,40.49,63.63A8,8,0,0,0,160,224h48a8,8,0,0,0,6.75-12.29ZM164.39,208,62.57,48h29L193.43,208Z",
};
function iconFor(url: string) {
	try {
		const host = new URL(url).hostname.replace(/^www\./, "");
		return ICONS[host === "twitter.com" ? "x.com" : host];
	} catch {
		return undefined;
	}
}
---

<Base title={siteTitle} description={siteTagline} content={home ? { collection: "pages", id: home.data.id, slug: "home" } : undefined}>
	<section class="intro">
		<h1 class="display headline" {...home?.edit.title}>
			<span class="marker">{home ? home.data.title : siteTitle}</span>
		</h1>
		<div class="body" {...home?.edit.content}>
			{home ? <PortableText value={home.data.content} /> : <p>{siteTagline}</p>}
		</div>

		{links.length > 0 && (
			<ul class="links">
				{links.map((item) => {
					const icon = iconFor(item.url);
					return (
						<li>
							<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>
								{icon && (
									<svg viewBox="0 0 256 256" width="18" height="18" aria-hidden="true">
										<path d={icon} fill="currentColor" />
									</svg>
								)}
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
		)}
	</section>
</Base>

<style>
	.intro { padding-top: clamp(1rem, 6vw, 5.5rem); }
	.headline {
		max-width: 40rem;
		font-size: clamp(2.125rem, 6.5vw, 3.25rem);
		line-height: 1.4;
		white-space: pre-line;
	}
	.body {
		max-width: 35rem;
		margin-top: 2.5rem;
		color: var(--text-soft);
		line-height: 2;
	}
	.body :global(p) { margin: 0 0 1rem; }
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.125rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.75rem 1.25rem;
		border: 1.5px solid var(--fg);
		border-radius: 999px;
		background: var(--button-bg);
		box-shadow: 3px 3px 0 var(--fg);
		color: var(--fg);
		font-family: var(--font-ui);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		transform: rotate(1.5deg);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	/* 1 つ目だけ塗りつぶし。傾きを交互に変えて、手で貼ったような並びにする */
	.links li:first-child a { background: var(--fg); color: var(--bg); transform: rotate(-2deg); }
	.links li:nth-child(3n) a { transform: rotate(-1deg); }
	.links li a:hover { transform: translate(-1px, -1px) rotate(0deg); box-shadow: 4px 4px 0 var(--fg); }
	.links li a:active { transform: translate(2px, 2px) rotate(0deg); box-shadow: 1px 1px 0 var(--fg); }
	@media (prefers-reduced-motion: reduce) {
		.links a { transition: none; }
	}
</style>
