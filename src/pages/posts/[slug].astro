---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	extractPlainText,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { formatDate } from "../../utils/date";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

// 前後の記事（公開日の古い方が「前」、新しい方が「次」）。
// 公開日が同じ記事もあるので、公開日が同じものも含めて取り、並び順の中で現在の記事の次を探す。
// EmDash は orderBy の向きに合わせて id で同順位を並べるので、desc と asc の並びは互いにちょうど逆順になる。
// 同じ公開日の記事が多くても見落とさないよう、現在の記事とその次が見つかるまでカーソルでページを進める。
const publishedAt = post.data.publishedAt?.toISOString();
const currentId = post.data.id;
const neighborCacheHints: (typeof cacheHint)[] = [];

async function findNeighbor(direction: "older" | "newer") {
	if (!publishedAt) return undefined;
	const where = { published_at: direction === "older" ? { lte: publishedAt } : { gte: publishedAt } };
	const orderBy = { published_at: direction === "older" ? "desc" : "asc" } as const;
	let cursor: string | undefined;
	let foundCurrent = false;
	do {
		const page = await getEmDashCollection("posts", { where, orderBy, limit: 20, cursor });
		neighborCacheHints.push(page.cacheHint);
		for (const entry of page.entries) {
			if (foundCurrent) return entry;
			if (entry.data.id === currentId) foundCurrent = true;
			// プレビュー中の未公開記事など、現在の記事が一覧にない場合は同じ公開日の範囲を抜けたところで止める
			else if (entry.data.publishedAt?.toISOString() !== publishedAt) return entry;
		}
		cursor = page.nextCursor;
	} while (cursor);
	return undefined;
}

const [older, newer, settings] = await Promise.all([
	findNeighbor("older"),
	findNeighbor("newer"),
	getSiteSettings(),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	for (const hint of neighborCacheHints) Astro.cache.set(hint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings);

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// 日本語は 1 分あたり約 500 文字で読了時間を見積もる
const readingMinutes = Math.max(1, Math.round(extractPlainText(post.data.content).length / 500));

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
	pageType="article"
	articleMeta={{
		publishedTime: post.data.publishedAt?.toISOString() ?? null,
		modifiedTime: post.data.updatedAt?.toISOString() ?? null,
	}}
>
	<article>
		<header class="post-header">
			<a class="text-link" href="/posts">← ブログ一覧へ</a>
			<p class="mono-meta">
				{post.data.publishedAt && (
					<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
				)}
				{post.data.publishedAt && " · "}
				{readingMinutes} min read
			</p>
			<h1 class="display title"><span class="marker" {...post.edit.title}>{post.data.title}</span></h1>
			{
				(categories.length > 0 || tags.length > 0) && (
					<ul class="tags">
						{categories.map((c) => (
							<li><a href={`/category/${c.slug}`}>{c.label}</a></li>
						))}
						{tags.map((t) => (
							<li><a href={`/tag/${t.slug}`}>#{t.label}</a></li>
						))}
					</ul>
				)
			}
		</header>

		{
			post.data.featured_image && (
				<div class="cover" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		<div class="prose" {...post.edit.content}>
			<PortableText value={post.data.content} />
		</div>
	</article>

	<nav class="adjacent" aria-label="前後の記事">
		<div>
			<span class="label">← 前の記事</span>
			{older ? <a href={`/posts/${older.id}`}>{older.data.title}</a> : <span class="none">—</span>}
		</div>
		<div class="next">
			<span class="label">次の記事 →</span>
			{newer ? <a href={`/posts/${newer.id}`}>{newer.data.title}</a> : <span class="none">—</span>}
		</div>
	</nav>

	<a slot="footer" class="text-link" href="/posts">ブログ一覧へ →</a>
</Base>

<style>
	article, .adjacent { max-width: var(--article); margin-inline: auto; }
	.post-header { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
	.post-header .mono-meta { margin: 0; }
	.title { font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.45; }
	.cover { margin-top: 2.5rem; }
	.cover :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 8px;
	}
	.prose { max-width: var(--measure); margin: 3.5rem auto 0; }
	.adjacent {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin-top: 4.5rem;
		padding-block: 1.75rem;
		border-block: 1px solid var(--line);
	}
	.adjacent > div { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
	.adjacent .next { align-items: flex-end; text-align: right; }
	.label { color: var(--muted); font-size: 0.75rem; line-height: 1.4; }
	.adjacent a, .none { font-size: 0.875rem; font-weight: 500; line-height: 1.5; }
	.adjacent a { color: var(--fg); text-decoration: none; }
	.adjacent a:hover { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 0.2em; }
	.none { color: var(--muted); }
	@media (max-width: 40rem) {
		.cover { margin-inline: calc(var(--gutter) * -1); }
		.cover :global(img) { border-radius: 0; }
	}
</style>
