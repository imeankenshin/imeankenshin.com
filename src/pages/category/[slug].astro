---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { findTermBySlug } from "../../utils/taxonomy";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? findTermBySlug(termsResult.data, slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`カテゴリ: ${term.label}`} description={`「${term.label}」の記事一覧`}>
	<p class="mono-meta kicker">カテゴリ</p>
	<h1 class="display page-title"><span class="marker">{term.label}</span></h1>

	{
		posts.length === 0 ? (
			<p class="lead">まだ記事がありません。</p>
		) : (
			<ul class="post-grid">
				{posts.map((post) => (
					<li><PostCard post={post} /></li>
				))}
			</ul>
		)
	}

	<nav slot="footer" class="pager" aria-label="ページ送り">
		{cursor && <a class="text-link" href={`/category/${term.slug}`}>← 最初のページ</a>}
		{nextCursor && <a class="text-link" href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>もっと見る →</a>}
	</nav>
</Base>

<style>
	.kicker { margin: 0 0 0.75rem; }
	.pager { display: flex; gap: 1.5rem; }
</style>
